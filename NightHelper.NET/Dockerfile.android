FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

# Install prereqs
RUN apt-get update && apt-get install -y unzip wget clang llvm lld

# Download Android NDK r26c (recommended for .NET 8)
RUN wget -q https://dl.google.com/android/repository/android-ndk-r26c-linux.zip \
    && unzip -q android-ndk-r26c-linux.zip -d /opt/ \
    && rm android-ndk-r26c-linux.zip

ENV ANDROID_NDK_ROOT=/opt/android-ndk-r26c

# Installa JDK per Android SDK
RUN apt-get update && apt-get install -y openjdk-17-jdk

# Download Android SDK Command Line Tools
RUN wget -q https://dl.google.com/android/repository/commandlinetools-linux-10406996_latest.zip \
    && unzip -q commandlinetools-linux-10406996_latest.zip -d /opt/android-sdk/ \
    && rm commandlinetools-linux-10406996_latest.zip

# Accetta licenze e installa SDK
RUN yes | /opt/android-sdk/cmdline-tools/bin/sdkmanager --sdk_root=/opt/android-sdk "platforms;android-34"
ENV ANDROID_SDK_ROOT=/opt/android-sdk

WORKDIR /src
COPY . .

# Installa i workload necessari per la build Android AOT
RUN dotnet workload install android

# Pubblica la libreria Native AOT per Android
RUN dotnet publish -c Release -r android-arm64 -p:NativeLib=Shared -p:AndroidSdkDirectory=/opt/android-sdk -o /out

# L'output finale sarà /out/NightHelper.NET.so
